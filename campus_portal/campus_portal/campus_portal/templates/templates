{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NOVA Campus student portal — learning, updates, and student support.">
    <title>{% block title %}NOVA Campus | Student Portal{% endblock %}</title>
    <link rel="stylesheet" href="{% static 'css/style.css' %}">
    {% block extra_head %}{% endblock %}
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="{% url 'home' %}" aria-label="NOVA Campus home">
                <img src="{% static 'images/nova-campus-logo.png' %}" alt="" class="brand-logo">
                <span class="brand-copy"><strong>NOVA</strong><small>CAMPUS PORTAL</small></span>
            </a>
            <nav class="main-nav" aria-label="Main navigation">
                <a href="{% url 'home' %}" {% if request.resolver_match.url_name == 'home' %}aria-current="page"{% endif %}>Home</a>
                <a href="{% url 'about' %}" {% if request.resolver_match.url_name == 'about' %}aria-current="page"{% endif %}>About</a>
            </nav>
        </div>
    </header>

    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>© {% now "Y" %} NOVA Campus. Built for student success.</p>
            <a href="{% url 'about' %}">Learn about the portal</a>
        </div>
    </footer>
</body>
</html>
